{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    "verbatimModuleSyntax": false,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
